    "test:e2e": "playwright test",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/react": "7.0.0",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.5",
    "jszip": "3.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "7.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@paddleocr/paddleocr-js": "0.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "@playwright/test": "1.55.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "vscode-languageserver-types": "3.18.4"
