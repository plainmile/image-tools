---
import Base from '../layouts/Base.astro';
import Editor from '../components/Editor.jsx';
const pages={
'resize-image':{title:'Resize Image Online — Exact Pixels | PlainMile',description:'Resize JPG, PNG or WebP images to exact width and height in pixels. Fit or crop privately in your browser.',heading:'Resize images to exact pixel dimensions',lead:'Choose width, height, and whether to keep the full picture or crop to fill. Export JPG, PNG, or WebP locally.',use:'For forms, profile photos, graphics and upload portals where a precise width and height matters.',hint:'Fit mode preserves the whole image with whitespace; fill mode crops the edges. Set both dimensions before downloading.'},
'compress-image-to-size':{title:'Compress Image to a Target KB Online | PlainMile',description:'Reduce JPG and WebP file sizes to a requested maximum KB. Verify actual bytes, with optional downscaling, in your browser.',heading:'Compress an image below a KB limit',lead:'Set a maximum file size (for example 50, 100 or 200 KB). We inspect the real exported bytes, not a predicted estimate.',use:'For application portals or online forms that reject files exceeding a specified size.',hint:'JPEG/WebP allow quality adjustments; PNG is lossless and can be harder to shrink. When permitted, enable smaller output dimensions.'},
'signature-resizer':{title:'Signature Image Resizer — Pixels and KB | PlainMile',description:'Resize a signature image to specific pixel dimensions and maximum KB size without uploading it.',heading:'Resize a scanned signature for a form',lead:'Enter the requested width, height, and file-size limit before saving your signature locally.',use:'For portals requiring a signature image at a specified dimension and file-size range.',hint:'Check the application instructions. This tool does not validate signature authenticity or guarantee acceptance.'},
'bulk-image-resizer':{title:'Bulk Image Resizer — Local ZIP Download | PlainMile',description:'Resize up to 30 JPG, PNG or WebP files in your browser and download a ZIP of processed images.',heading:'Resize multiple images together',lead:'Pick several images, apply one set of pixel dimensions and export a ZIP. No server transfer or account.',use:'For consistent image collections, catalogs and repeat upload tasks.',hint:'A batch uses the same output width and height for every selected image. Keep your originals.'},
'passport-photo-print':{title:'4×6 Passport Photo Print Sheet — Free | PlainMile',description:'Arrange six manually cropped 2×2 inch photos onto a 4×6 inch JPEG print sheet locally. No upload.',heading:'Create a 4×6 photo print sheet',lead:'Frame an existing photo and generate a 1200×1800 JPEG with six 600×600 photo tiles for printing at 300 pixels per inch.',use:'For printing six square copies where 2×2-inch size is specifically required.',hint:'This is only a print layout, not a passport approval or automatic compliance check. Many authorities prohibit digitally altered photos; verify official instructions.'}
};
export function getStaticPaths(){return ['resize-image','compress-image-to-size','signature-resizer','bulk-image-resizer','passport-photo-print'].map(tool=>({params:{tool}}));}
const tool=Astro.params.tool;const page=pages[tool];
const guide={"resize-image":{"heading":"Fit, crop or preserve proportions?","intro":"Pixel dimensions describe the downloaded image, not its display size. If a website asks for 600 × 400 pixels, enter exactly that. Fit keeps the full original inside those dimensions, leaving space when necessary. Fill and crop covers the target area and trims the edges without stretching.","q":[["How do I keep the original aspect ratio?","Select Keep aspect ratio before changing width or height. If the destination requires a different shape, choose Fit or Fill and crop."],["Will enlarging a small image improve its detail?","No. More pixels cannot restore detail absent from a low-resolution source. Try to start with the largest available original."]],"links":[["/compress-image-to-size/","Compress under a KB limit"],["/bulk-image-resizer/","Resize a batch"]]},"compress-image-to-size":{"heading":"Use the size limit from your upload form","intro":"Enter the maximum permitted KB, such as 50 or 100. The editor checks the actual output bytes after encoding. JPEG and WebP can reduce file size by lowering quality. When the limit is too small for the selected dimensions, allowing smaller dimensions may help.","q":[["How do I make a photo smaller than 100 KB?","Enter 100 for the maximum size and choose JPEG or WebP when accepted. The output must also meet any minimum pixel dimensions set by the destination."],["Why can PNG be difficult to compress?","PNG is lossless. Detailed photos often remain relatively large; switch to JPEG or WebP only if the receiving website supports that format."]],"links":[["/resize-image/","Set exact pixel dimensions"],["/signature-resizer/","Resize a signature"]]},"signature-resizer":{"heading":"Match both the pixel dimensions and KB limit","intro":"Application forms sometimes require a specific signature width, height and maximum file size. Use the values printed in the form rather than a general preset. The editor adjusts image dimensions and encoding, but does not remove a scanned background or validate a signature.","q":[["Should I export a transparent signature?","Use the format accepted by the form. PNG and WebP can preserve existing transparency. JPEG saves onto a white background."],["Can this tool guarantee the form accepts my signature?","No. File format, minimum image quality and signature validity depend on the receiving organization."]],"links":[["/compress-image-to-size/","Compress to a file-size limit"],["/resize-image/","Resize a photo"]]},"bulk-image-resizer":{"heading":"Apply one resize rule to a set of pictures","intro":"Choose up to 30 JPEG, PNG or WebP files, 160 MB total. The same width, height, format and crop settings are applied to each picture. Fit preserves the full picture with padding, while Fill and crop trims the edges. The results are packaged into one ZIP.","q":[["What if my photos have different aspect ratios?","Use Fit to keep each picture whole, or Fill and crop to make every result fill the target rectangle. Neither option stretches the source."],["Are originals overwritten?","No. A ZIP containing new output files is downloaded. Your original images are not modified."]],"links":[["/resize-image/","Resize a single image"],["/compress-image-to-size/","Compress to KB"]]},"passport-photo-print":{"heading":"Print size and official photo requirements","intro":"This tool places six identical 600 × 600 pixel tiles on a 1200 × 1800 pixel JPEG and sets its density to 300 DPI. Print on 4 × 6 inch paper at actual size; some print dialogs automatically zoom, add margins or crop borderless prints.","q":[["Does this verify a passport or visa photo?","No. It does not check lighting, pose, background, clothing or official acceptance. Follow the issuing authority’s instructions; digital alterations may not be allowed."],["Why does the printed photo measure incorrectly?","Confirm 4 × 6 inch paper, 100% scale and any borderless-cropping option in your printer or lab settings."]],"links":[["/resize-image/","Resize a digital photo"],["/compress-image-to-size/","Compress a photo"]]}}[tool];
---
<Base path={'/'+tool+'/'} title={page.title} description={page.description}>
<section class="page-head"><p class="breadcrumb"><a href="/">Image tools</a> / {page.heading}</p><h1>{page.heading}</h1><p class="lead">{page.lead}</p></section>
<Editor client:load lang="en" tool={tool}/>
<section class="reference" aria-label="Help for this tool">
<h2>{guide.heading}</h2><p>{guide.intro}</p><p>{page.hint}</p>
<h2>Common questions</h2>
{guide.q.map(([question,answer])=><div class="qa"><h3>{question}</h3><p>{answer}</p></div>)}
<h2>Related tools</h2><ul class="related-links">{guide.links.map(([href,label])=><li><a href={href}>{label}</a></li>)}</ul>
<p class="editor-disclosure">Images are processed in this browser tab. Read the <a href="/privacy/">privacy policy</a>.</p>
</section>
</Base>
