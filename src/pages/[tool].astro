---
import Base from '../layouts/Base.astro';
import Editor from '../components/Editor.jsx';
const pages={
'resize-image':{title:'Resize Image Online — Exact Pixels | PlainMile',description:'Resize JPG, PNG or WebP images to exact width and height in pixels. Fit or crop privately in your browser.',heading:'Resize images to exact pixel dimensions',lead:'Choose width, height, and whether to keep the full picture or crop to fill. Export JPG, PNG, or WebP locally.',use:'For forms, profile photos, graphics and upload portals where a precise width and height matters.',hint:'Fit mode preserves the whole image with whitespace; fill mode crops the edges. Set both dimensions before downloading.'},
'compress-image-to-size':{title:'Compress Image to a Target KB Online | PlainMile',description:'Reduce JPG and WebP file sizes to a requested maximum KB. Verify actual bytes, with optional downscaling, in your browser.',heading:'Compress an image below a KB limit',lead:'Set a maximum file size (for example 50, 100 or 200 KB). We inspect the real exported bytes, not a predicted estimate.',use:'For application portals or online forms that reject files exceeding a specified size.',hint:'JPEG/WebP allow quality adjustments; PNG is lossless and can be harder to shrink. When permitted, enable smaller output dimensions.'},
'signature-resizer':{title:'Signature Image Resizer — Pixels and KB | PlainMile',description:'Resize a signature image to specific pixel dimensions and maximum KB size without uploading it.',heading:'Resize a scanned signature for a form',lead:'Enter the requested width, height, and file-size limit before saving your signature locally.',use:'For portals requiring a signature image at a specified dimension and file-size range.',hint:'Check the application instructions. This tool does not validate signature authenticity or guarantee acceptance.'},
'bulk-image-resizer':{title:'Bulk Image Resizer — Local ZIP Download | PlainMile',description:'Resize up to 30 JPG, PNG or WebP files in your browser and download a ZIP of processed images.',heading:'Resize multiple images together',lead:'Pick several images, apply one set of pixel dimensions and export a ZIP. No server transfer or account.',use:'For consistent image collections, catalogs and repeat upload tasks.',hint:'A batch uses the same output width and height for every selected image. Keep your originals.'},
'passport-photo-print':{title:'4×6 Passport Photo Print Sheet — Free | PlainMile',description:'Arrange six manually cropped 2×2 inch photos onto a 4×6 inch JPEG print sheet locally. No upload.',heading:'Create a 4×6 photo print sheet',lead:'Frame an existing photo and generate a 1200×1800 JPEG with six 600×600 photo tiles for printing at 300 pixels per inch.',use:'For printing six square copies where 2×2-inch size is specifically required.',hint:'This is only a print layout, not a passport approval or automatic compliance check. Many authorities prohibit digitally altered photos; verify official instructions.'}
};
export function getStaticPaths(){return ['resize-image','compress-image-to-size','signature-resizer','bulk-image-resizer','passport-photo-print'].map(tool=>({params:{tool}}));}
const tool=Astro.params.tool;const page=pages[tool];
---
<Base path={'/'+tool+'/'} title={page.title} description={page.description}>
<section class="page-head"><h1>{page.heading}</h1><p class="lead">{page.lead}</p></section>
<Editor client:load lang="en" tool={tool}/>
<section class="reference"><h2>When should you use this tool?</h2><p>{page.use}</p><h2>How it works</h2><ol><li>Select a JPEG, PNG, or WebP image from your device.</li><li>Adjust the visible options and run the operation.</li><li>Check the actual image size and download the result.</li></ol><p>{page.hint}</p><h2>File handling</h2><p>Images are processed in this browser tab. See the <a href="/privacy/">privacy policy</a> for details.</p></section>
</Base>
