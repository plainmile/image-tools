---
import Base from '../layouts/Base.astro';
const entries = [
  ['resize-image/', 'Resize image', 'Set width and height in pixels; fit or crop.'],
  ['compress-image-to-size/', 'Compress to a file-size limit', 'Save a JPG or WebP under a specified KB limit.'],
  ['signature-resizer/', 'Resize signature', 'Adjust signature dimensions and file size.'],
  ['bulk-image-resizer/', 'Bulk resize', 'Apply the same settings to several images and download a ZIP.'],
  ['passport-photo-print/', '4×6 photo print sheet', 'Arrange six 2×2-inch photos for printing.'],
  ['redact-image/', 'Redact images and screenshots', 'Review OCR text suggestions, choose covers manually and export batches.']
];
---
<Base title="Free Image Tools — Resize, Compress & Redact | PlainMile" description="Resize photos, compress images below KB limits, cover text in screenshots and create print sheets. English and Chinese tools process images locally in your browser.">
  <section class="home-head"><h1>Image tools</h1><p class="lead">Resize, compress, redact or prepare images for forms and printing. Choose a tool to start.</p></section>
  <section class="home-tools" aria-label="Image tools">
    <div class="tool-list">{entries.map(([path,title,detail])=><a class="tool-link" href={'/'+path}><span><strong>{title}</strong><small>{detail}</small></span><span class="arrow" aria-hidden="true">›</span></a>)}</div>
  </section>
  <section class="reference"><h2>Files and formats</h2><p>JPG, PNG and WebP are supported. Files are processed in your browser, and the downloaded result shows its actual size and dimensions. Very small KB limits may require reduced image quality or dimensions.</p><p>Other PlainMile tools: <a href="https://plainmile.com/">PlainMile</a> and <a href="https://pdf.plainmile.com/">PDF Tools</a>.</p></section>
</Base>
