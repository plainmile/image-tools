---
import Base from '../../layouts/Base.astro';
const entries = [
  ['resize-image/', '修改图片尺寸', '默认等比例缩放无白边，并保留 JPG、PNG 或 WebP 格式；需要固定尺寸时再选择留白或裁剪。'],
  ['compress-image-to-size/', '压缩到指定 KB', '将 JPG、WebP 压缩到规定的文件大小。'],
  ['convert-image/', '图片格式转换', 'JPG、PNG、WebP 相互转换，不改变原图像素尺寸；支持批量 ZIP 下载。'],
  ['crop-image/', '裁剪图片', '拖动裁剪框保留需要的区域，支持正方形、横向和竖向比例。'],
  ['rotate-image/', '旋转与翻转', '向左或向右旋转图片，或者水平、垂直翻转，可预览效果。'],
  ['bulk-image-resizer/', '批量修改图片', '支持一张或多张，默认保留各自格式，成功一张直接下载，多张打包 ZIP。'],
  ['redact-image/', '图片打码与批量遮挡', '手动画框打码，支持黑色遮挡、马赛克、模糊和批量导出。'],
  ['signature-resizer/', '调整签名图片', '设置签名图片的尺寸和文件大小。'],
  ['passport-photo-print/', '4×6 英寸照片排版', '将同一张 2×2 英寸照片重复六份，排版在 4×6 英寸相纸上。']
];
---
<Base lang="zh" title="免费图片工具 — 裁剪、旋转、压缩与格式转换 | PlainMile" description="在线裁剪、旋转、翻转、压缩图片与转换 JPG、PNG、WebP 格式，还可批量调整尺寸和图片打码。图片在浏览器本地处理，无需上传。也可粘贴截图直接处理。">
  <section class="home-head"><h1>图片工具</h1><p class="lead">裁剪、旋转、格式转换、调整尺寸、压缩、图片打码或准备打印照片。选择需要的功能即可开始。</p></section>
  <section class="home-tools" aria-label="图片工具">
    <div class="tool-list">{entries.map(([path,title,detail])=><a class="tool-link" href={'/zh/'+path}><span><strong>{title}</strong><small>{detail}</small></span><span class="arrow" aria-hidden="true">›</span></a>)}</div>
  </section>
  <section class="reference"><h2>支持的格式</h2><p>目前支持 JPG、PNG 和 WebP。裁剪会去掉图片边缘、旋转改变方向，格式转换保持原有像素尺寸。普通缩放和批量处理默认保留原格式与 PNG 透明背景。按 KB 压缩默认输出 JPG，如果源图有透明区域会提示转白风险。全部在浏览器本地处理，结果显示实际宽高和文件大小。</p><p>其他 PlainMile 工具：<a href="https://plainmile.com/">PlainMile 主站</a>、<a href="https://pdf.plainmile.com/">PDF 工具</a>。</p></section>
</Base>
