---
import Base from '../../layouts/Base.astro';
const entries = [
  ['resize-image/', '修改图片尺寸', '指定宽高像素，选择完整保留或裁剪。'],
  ['compress-image-to-size/', '压缩到指定 KB', '将 JPG、WebP 压缩到规定的文件大小。'],
  ['signature-resizer/', '调整签名图片', '设置签名图片的尺寸和文件大小。'],
  ['bulk-image-resizer/', '批量修改图片', '统一处理多张图片，打包下载 ZIP。'],
  ['passport-photo-print/', '4×6 英寸照片排版', '将六张 2×2 英寸照片排版打印。'],
  ['redact-image/', '图片打码与批量遮挡', '手动画框打码，支持黑色遮挡、马赛克、模糊和批量导出。']
];
---
<Base lang="zh" title="免费图片工具 — 尺寸、压缩和图片打码 | PlainMile" description="在线修改图片尺寸、压缩到指定 KB、图片手动打码、马赛克、模糊、批量处理与照片打印排版。文件在浏览器中处理，不上传图片内容。">
  <section class="home-head"><h1>图片工具</h1><p class="lead">调整图片尺寸、压缩文件大小、打码遮挡文字或准备打印照片。选择需要的功能即可开始。</p></section>
  <section class="home-tools" aria-label="图片工具">
    <div class="tool-list">{entries.map(([path,title,detail])=><a class="tool-link" href={'/zh/'+path}><span><strong>{title}</strong><small>{detail}</small></span><span class="arrow" aria-hidden="true">›</span></a>)}</div>
  </section>
  <section class="reference"><h2>支持的格式</h2><p>目前支持 JPG、PNG 和 WebP。图片在当前浏览器中处理，结果会显示实际尺寸和文件大小。过小的 KB 限制可能需要降低画质或像素。</p><p>其他 PlainMile 工具：<a href="https://plainmile.com/">PlainMile 主站</a>、<a href="https://pdf.plainmile.com/">PDF 工具</a>。</p></section>
</Base>
