---
import Base from '../../layouts/Base.astro';
import Editor from '../../components/Editor.jsx';
const pages={
'resize-image':['按比例缩放图片尺寸（无白边） | PlainMile','浏览器内按比例调整 JPG、PNG、WebP 图片尺寸，默认不加白边、不裁剪。可设置最大宽高，也可选固定尺寸留白或裁剪。','按比例调整图片尺寸，不添加白边','默认保持原图比例缩小，不会添加白边或裁剪。填写最大宽高，如需固定输出像素，可选择留白或裁剪。','普通等比例模式不会放大小图，默认保持原图 JPG、PNG、WebP 格式。要求精确宽高时，请选择固定尺寸：完整显示可能留白，裁剪填满可能切掉边缘。'],
'compress-image-to-size':['在线压缩图片到指定 KB | PlainMile','在浏览器中把 JPG、WebP 图片压缩到指定最大 KB，查看实际文件大小；必要时调整画质或允许缩小像素。','将图片压缩到指定 KB 以下','设置最大文件大小，例如 50KB、100KB 或 200KB。下载前会检测真实输出文件大小。','压缩页默认导出 JPG，透明 PNG/WebP 转成 JPG 会变成白色背景；需要透明时请选择保留原始格式或 PNG/WebP。PNG 是无损格式，难以满足很小的 KB 限制。'],
'signature-resizer':['签名图片尺寸和 KB 调整 | PlainMile','按比例缩小电子签名并控制最大宽高和 KB；要求精确像素时可选留白或裁剪，图片在浏览器本地处理。','修改电子签名图片','默认按比例缩小并限制最大宽高；若申请要求精确像素，请显式选择固定尺寸后处理。','默认保留原始格式及 PNG 透明背景，不会擅自设置文件大小限制。若申请网站要求精确宽高或最大 KB，请按规定自行填写；本工具不验证签名真实性。'],
'bulk-image-resizer':['在线批量修改图片尺寸 | PlainMile','浏览器内批量按比例缩放最多 30 张 JPG、PNG、WebP 图片，默认不加白边，结果打包 ZIP 下载。','批量按比例修改图片尺寸','填写一组最大宽高，每张图片默认按原有比例缩小，结果打包 ZIP 下载。','默认保持每张原图的 JPG、PNG 或 WebP 格式，单张批处理也打包 ZIP；需要统一精确像素尺寸时，请显式选择留白或裁剪。'],
'passport-photo-print':['4×6 英寸证件照打印排版 | PlainMile','将同一张 2×2 英寸方形照片复制六份，排版为 4×6 英寸 JPEG 打印文件，支持手动裁剪和位置调整，打印前核对官方照片要求。','制作 4×6 英寸照片打印排版','手动选择和调整原始照片取景，生成六张方形照片的 1200×1800 打印图片。','这只是排版工具，不保证任何官方证件照申请要求；很多机构禁止对照片进行数字修改。请核对官方规定。']
};
export function getStaticPaths(){return ['resize-image','compress-image-to-size','signature-resizer','bulk-image-resizer','passport-photo-print'].map(tool=>({params:{tool}}));}
const tool=Astro.params.tool;const [title,description,heading,lead,hint]=pages[tool];
const examples={
  'resize-image':'例如：1920 × 1080 的照片，最大宽高都设为 800，实际输出为 800 × 450，不会有白边；如果需要精确 800 × 800，则要选择固定尺寸留白或裁剪。',
  'compress-image-to-size':'例如：上传系统限制 100 KB，可将最大大小设置为 100，先尝试 JPG 90% 画质。工具会核对导出的实际字节数，未达到目标时可降低画质或允许缩小像素。',
  'signature-resizer':'例如：申请表严格要求 300 × 100 像素，请选择固定尺寸模式。默认等比例模式只把这两个值作为上限，不保证输出正好等于该宽高。 固定尺寸模式会保持指定宽高，若同时设置的 KB 上限无法满足，会报错而不是偷偷缩小图片。',
  'bulk-image-resizer':'例如：1600 × 900 的 JPG 和 800 × 1200 的 PNG，最大宽高设为 800 时，分别输出 800 × 450 的 JPG 和 533 × 800 的 PNG，并存入一个 ZIP。',
  'passport-photo-print':'例如：生成 1200 × 1800 的 JPG，包含六张 600 × 600 像素照片并设置为 300 DPI；打印仍需选择 4 × 6 英寸和 100% 比例。'
};
const guide={"resize-image":{"heading":"等比例缩放、留白、裁剪有什么区别？","intro":"默认按原始比例缩放到指定最大宽高内，不添加白边、不裁剪也不放大小图。如果网站要求精确的 600 × 400 像素，请选“裁剪边缘，填满尺寸”（可能裁掉部分图片），或“保留整张图，空白补齐”（可能出现空白边）。","q":[["为什么下载图片的高度没有达到最大高度？","等比例缩放会保持原图比例，不超过填写的最大宽高。处理前页面会显示预计输出尺寸。"],["怎样导出精确的宽高？","切换固定尺寸模式。完整显示可能添加白边，裁剪填满可能切掉部分原图。"],["放大图片会更清晰吗？","不会。默认比例模式不放大小图；放大无法恢复原图缺少的细节。"],["为什么同步宽高后尺寸自动变小？","在固定尺寸模式中勾选“同步修改宽高”后，如果超出浏览器单边 10000 像素或输出 3200 万像素上限，工具会同时缩小宽高以保持原始比例，并在页面中提示。"]],"links":[["/zh/compress-image-to-size/","压缩到指定 KB"],["/zh/bulk-image-resizer/","批量调整图片"]]},"compress-image-to-size":{"heading":"怎样符合上传文件大小的限制？","intro":"最大 KB 请填写上传网站给出的实际要求，比如 50 或 100。工具编码后会检查真实文件大小；降低 JPG、WebP 画质可以减少字节数。如果限制太小，可能还需要允许缩小像素。","q":[["上传要求小于 100 KB，应该怎么设置？","最大大小填写 100，必要时勾选允许缩小像素。下载前还需检查接收网站对最小像素、图片格式的要求。"],["为什么 PNG 不容易压缩？","PNG 是无损编码，复杂照片通常较大。如果接收网站允许，可改用 JPG 或 WebP。"]],"links":[["/zh/resize-image/","修改图片像素"],["/zh/signature-resizer/","签名图片调整"]]},"signature-resizer":{"heading":"按照申请系统的要求准备签名","intro":"在线申请系统可能同时限制签名图片的精确宽高、文件格式和 KB。默认比例模式只保证不超过最大宽高；如需精确尺寸，应切换固定尺寸的完整显示或填满裁剪。本工具不自动去背景，也不验证签名真实性。","q":[["签名应该选择白色还是透明背景？","应以接收系统要求为准。默认保留原始格式，透明 PNG 或 WebP 可以继续保留透明；如果选择 JPG，透明部分会变白。对 KB 有严格限制时请确认可用的格式。"],["处理完就一定符合官方要求吗？","不一定。工具仅改变图片尺寸和编码，签名真实性及申请条件由接收机构判定。"]],"links":[["/zh/compress-image-to-size/","减小文件大小"],["/zh/resize-image/","修改图片尺寸"]]},"bulk-image-resizer":{"heading":"同一批图片的尺寸如何统一？","intro":"一次最多选择 30 张图片，文件总大小上限 160 MB。默认每张按自身比例缩小，并保留原始 JPG、PNG 或 WebP 格式，不放大、不裁剪也不加白边。即使只选择一张也打包 ZIP；若要固定像素尺寸，请明确选择完整显示或填满裁剪。","q":[["不同长宽比例的图片会变形吗？","默认的不超过最大尺寸模式会保持各张图片比例、不留白；完整显示会留白，填满裁剪可能切去边缘。"],["为什么下载的是 ZIP 文件？","为方便连续处理和保留各自的导出文件名，批量工具即使仅处理一张，也统一下载 ZIP。原图不会被覆盖。"]],"links":[["/zh/resize-image/","单张修改尺寸"],["/zh/compress-image-to-size/","压缩图片"]]},"passport-photo-print":{"heading":"打印尺寸与证件照申请须知","intro":"输出是 1200 × 1800 像素的 JPG，内含六张相同的 600 × 600 像素方形照片，并设置 JPEG 密度为 300 DPI。实际打印时仍需选择 4 × 6 英寸相纸和 100% 比例，避免打印软件自动放大裁剪。","q":[["会自动检查护照或签证照片是否合格吗？","不会。本工具只负责裁剪和排版，不验证姿势、光线、背景或官方接受条件。部分机构禁止数字修改照片。"],["打印出来的尺寸不对怎么办？","请检查纸张尺寸、无边距打印以及自动适应纸张等设置，避免印刷软件再次缩放。"]],"links":[["/zh/resize-image/","修改电子照片"],["/zh/compress-image-to-size/","压缩照片"]]}}[tool];
---
<Base lang="zh" path={'/zh/'+tool+'/'} title={title} description={description}>
<section class="page-head"><p class="breadcrumb"><a href="/zh/">图片工具</a> / {heading}</p><h1>{heading}</h1><p class="lead">{lead}</p></section>
<Editor client:load lang="zh" tool={tool}/>
{tool!=='passport-photo-print'&&<p class="editor-disclosure">提示：您可以按 Ctrl+V（Mac 为 ⌘V）直接粘贴截图，随后在上方设置处理参数并下载。</p>}
<section class="reference" aria-label="工具使用说明">
<h2>{guide.heading}</h2><p>{guide.intro}</p><p>{examples[tool]}</p><p>{hint}</p>
<h2>常见问题</h2>
{guide.q.map(([question,answer])=><div class="qa"><h3>{question}</h3><p>{answer}</p></div>)}
<h2>相关工具</h2><ul class="related-links">{guide.links.map(([href,label])=><li><a href={href}>{label}</a></li>)}</ul>
<p class="editor-disclosure">图片仅在浏览器标签页中处理。详见<a href="/zh/privacy/">隐私说明</a>。</p>
</section>
</Base>
