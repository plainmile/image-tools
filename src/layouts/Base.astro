---
import '../styles/global.css';
const {title,description,lang='en',path='/',noindex=false}=Astro.props;
const origin='https://image.plainmile.com';
const normalized=path==='/'?'/':path.replace(/\/$/,'')+'/';
const english=normalized.startsWith('/zh/')?normalized.slice(3)||'/':normalized;
const chinese='/zh'+(english==='/'?'/':english);
const current=lang==='zh'?chinese:english;
const isHome=current==='/'||current==='/zh/';
const isPrivacy=current.endsWith('/privacy/');
const jsonld=isHome
  ? {'@context':'https://schema.org','@type':'WebSite',name:'PlainMile Image Tools',url:origin+current,inLanguage:lang==='zh'?'zh-CN':'en'}
  : isPrivacy
    ? {'@context':'https://schema.org','@type':'WebPage',name:title,url:origin+current,inLanguage:lang==='zh'?'zh-CN':'en'}
    : {'@context':'https://schema.org','@type':'WebApplication',name:title,description,applicationCategory:'MultimediaApplication',operatingSystem:'Any modern browser',inLanguage:lang==='zh'?'zh-CN':'en',isAccessibleForFree:true,url:origin+current,offers:{'@type':'Offer',price:'0',priceCurrency:'USD'}};
const breadcrumb=isHome||isPrivacy?null:{
  '@context':'https://schema.org',
  '@type':'BreadcrumbList',
  itemListElement:[
    {'@type':'ListItem',position:1,name:lang==='zh'?'图片工具':'Image tools',item:origin+(lang==='zh'?'/zh/':'/')},
    {'@type':'ListItem',position:2,name:title,item:origin+current}
  ]
};
const links=lang==='zh'?[['/zh/','首页'],['/zh/resize-image/','调整尺寸'],['/zh/convert-image/','格式转换'],['/zh/crop-image/','裁剪'],['/zh/rotate-image/','旋转/翻转'],['/zh/compress-image-to-size/','压缩到指定 KB'],['/zh/signature-resizer/','签名尺寸'],['/zh/bulk-image-resizer/','批量处理'],['/zh/passport-photo-print/','照片排版'],['/zh/redact-image/','图片打码']]:[['/','Home'],['/resize-image/','Resize'],['/convert-image/','Convert'],['/crop-image/','Crop'],['/rotate-image/','Rotate/Flip'],['/compress-image-to-size/','Compress to KB'],['/signature-resizer/','Signature'],['/bulk-image-resizer/','Bulk resize'],['/passport-photo-print/','Photo print'],['/redact-image/','Redact']];
---
<!doctype html>
<html lang={lang==='zh'?'zh-CN':'en'}>
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="theme-color" content="#ffffff"/>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
  <title>{title}</title><meta name="description" content={description}/>
  <meta property="og:type" content="website"/>
  <meta property="og:site_name" content="PlainMile Image Tools"/>
  <meta property="og:title" content={title}/>
  <meta property="og:description" content={description}/>
  <meta property="og:url" content={origin+current}/>
  <meta property="og:locale" content={lang==='zh'?'zh_CN':'en_US'}/>
  <meta property="og:locale:alternate" content={lang==='zh'?'en_US':'zh_CN'}/>
  <meta name="twitter:card" content="summary"/>

  {noindex?<meta name="robots" content="noindex,follow"/>:<>
    <link rel="canonical" href={origin+current}/>
    <link rel="alternate" hreflang="en" href={origin+english}/>
    <link rel="alternate" hreflang="zh-CN" href={origin+chinese}/>
    <link rel="alternate" hreflang="x-default" href={origin+english}/>
  </>}
  {!noindex&&<script type="application/ld+json" set:html={JSON.stringify(jsonld)}/> }
  {!noindex&&breadcrumb&&<script type="application/ld+json" set:html={JSON.stringify(breadcrumb)}/>}
</head>
<body>
<a class="skip-link" href="#main-content">{lang==='zh'?'跳转到主要内容':'Skip to main content'}</a>
<header class="site-header"><div class="shell header-row"><a class="brand" href={lang==='zh'?'/zh/':'/'}><span>PlainMile</span><span class="brand-separator">/</span><span class="brand-product">Image Tools</span></a><div class="lang-switch"><a lang={lang==='zh'?'en':'zh-CN'} href={lang==='zh'?english:chinese}>{lang==='zh'?'English':'简体中文'}</a></div></div></header>
<div class="nav-wrap"><nav class="nav shell" aria-label={lang==='zh'?'工具导航':'Tool navigation'}>{links.map(([url,label])=><a href={url} aria-current={current===url?'page':undefined}>{label}</a>)}</nav></div>
<main id="main-content" class="shell" tabindex="-1"><slot/></main>
<footer class="footer"><div class="shell"><div>© PlainMile · Image Tools</div><div class="footer-links"><a href="https://plainmile.com/" rel="noopener noreferrer">{lang==='zh'?'PlainMile 主站':'PlainMile'}</a><a href="https://pdf.plainmile.com/" rel="noopener noreferrer">{lang==='zh'?'PDF 工具':'PDF Tools'}</a><a href={lang==='zh'?'/zh/privacy/':'/privacy/'}>{lang==='zh'?'隐私说明':'Privacy'}</a><a href="https://github.com/plainmile/image-tools/issues" rel="noopener noreferrer">{lang==='zh'?'反馈问题':'Feedback'}</a></div></div></footer>
</body>
</html>
